<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body{
            font-family: 'Times New Roman', Times, serif;
            margin: 0px;
            background-color: #f5f5f5;
        }
        .container{
            display: flex;
            gap: 20px;
            padding: 20px;
        }
        .box{
            width: 50%;
            background-color: white;
            border: 2px solid black;
            border-radius: 5px;
            padding: 20px;
        }
        textarea
        {
            width: 100%;
            height: 200px;
            border: none;
            outline: none;
            font-size: 12px;
        }
        iframe
        {
            width: 100%;
            height: 400px;
            border: none;
        }
        h4
        {
            margin-top: 0%;
        }
    </style>
</head>
<body>
    <!-- <% include("header.ejs") %> -->
   <h3 style="margin: 20px;">Code editor</h3>
   <div class="container">
        <div class="box">
            <h4>My code place</h4>
            <textarea name="code" id="code" placeholder="Write code here......."></textarea>
        </div>
        <div class="box">
            <h4>Preview</h4>
            <iframe id="preview"></iframe>
        </div>
   </div>
   <script>
    const code = document.getElementById("code");
    const preview = document.getElementById("preview");

    code.addEventListener("keyup", ()=>{
        preview.srcdoc = code.value;
    });
   </script>

    
</body>
</html>